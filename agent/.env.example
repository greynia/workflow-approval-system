# Copy to .env and fill in. .env is gitignored.

# --- Backend ---
BACKEND_BASE_URL=http://localhost:8080

# AI_AGENT service account (seeded by V15__ai_agent_role.sql).
# Password == the EMP007 (huang.yating@example.com) demo password (same bcrypt hash).
# Recover it from docs/01_development_roadmap.md (git history) or reset via a migration.
AGENT_EMAIL=ai-agent@system.local
AGENT_PASSWORD=
AGENT_PREFERRED_LOCALE=en          # en | zh-TW

REQUEST_TIMEOUT_SECONDS=30

# --- LLM (agent node) ---
GEMINI_API_KEY=
# Same default as the backend's built-in review. Any current Gemini model that
# supports tool calling works; gemini-2.0-flash was shut down on 2026-06-01.
GEMINI_MODEL=gemini-2.5-flash-lite
