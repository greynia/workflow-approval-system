# Copy to .env and fill in. .env is gitignored.

# --- Backend ---
BACKEND_BASE_URL=http://localhost:8080

# AI_AGENT service account (seeded by V15__ai_agent_role.sql).
# Password == the EMP007 (huang.yating@example.com) demo password (same bcrypt hash).
# Recover it from docs/01_development_roadmap.md (git history) or reset via a migration.
AGENT_EMAIL=ai-agent@system.local
AGENT_PASSWORD=
AGENT_PREFERRED_LOCALE=en          # en | zh-TW

REQUEST_TIMEOUT_SECONDS=30

# --- LLM (Phase 2+) ---
GEMINI_API_KEY=
# Set to a current Gemini "flash" model; gemini-2.0-flash is a safe default.
GEMINI_MODEL=gemini-2.0-flash
